# Baileys WhatsApp Server Configuration

# Server Port
PORT=21465

# Secret Key for API authentication
SECRET_KEY=THISISMYSECURETOKEN

# Auth sessions storage directory
AUTH_DIR=./auth_sessions

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Session idle timeout in seconds (sessions without activity will be closed)
SESSION_IDLE_TIMEOUT=300

# Maximum concurrent sessions (RAM management)
MAX_CONCURRENT_SESSIONS=5
